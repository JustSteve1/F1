# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Google BigQuery
BQ_PROJECT=f1-data-library
BQ_DATASET=f1_data_library_DS

# Service account: cursorf1@f1-data-library.iam.gserviceaccount.com
# Point this at the JSON key file (do not commit the key).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/cursorf1.json

# FastF1 cache directory (optional, defaults to ~/.cache/fastf1)
# FASTF1_CACHE_DIR=/path/to/cache

# Kaggle API token from https://www.kaggle.com/settings/api
# Preferred. Do not commit the token.
KAGGLE_API_TOKEN=your_kaggle_api_token

# Dataset to update (owner/slug)
KAGGLE_DATASET=stevefza/f1-2026-bahrain-testing-day-2
