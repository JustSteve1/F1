# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Google BigQuery
BQ_PROJECT=f1-data-library
BQ_DATASET=f1_data_library_DS

# Google auth — leave blank to use Application Default Credentials (recommended).
# Set this only if using a service account key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# FastF1 cache directory (optional, defaults to ~/.cache/fastf1)
# FASTF1_CACHE_DIR=/path/to/cache

# Kaggle — copy kaggle.json.example to ~/.kaggle/kaggle.json (chmod 600)
# OR set these env vars. Create keys at https://www.kaggle.com/settings/api
KAGGLE_USERNAME=stevefza
KAGGLE_KEY=your_kaggle_api_key
# Preferred for kagglehub: KAGGLE_API_TOKEN=your_kaggle_api_token

# Dataset to update (owner/slug)
KAGGLE_DATASET=stevefza/f1-2026-bahrain-testing-day-2
