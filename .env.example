# ── Postgres (job control plane) ─────────────────────────────────────────────
# Local docker:
# DATABASE_URL=postgresql://interval:interval@localhost:5432/interval_jobs
# DATABASE_SSL=false
#
# Cloud SQL (public IP + SSL) — Vercel / remote Next.js:
# DATABASE_URL=postgresql://interval_jobs:PASSWORD@INSTANCE_IP:5432/interval_jobs?sslmode=require
DATABASE_URL=
# DATABASE_SSL=true

# ── Worker trigger mode ──────────────────────────────────────────────────────
# stub      = in-process simulated progress (default, great for UI/dev)
# local     = spawn worker/entrypoint.py on this machine
# cloud_run = trigger GCP Cloud Run Job execution
JOB_WORKER_MODE=stub

# ── Cloud Run Jobs (required when JOB_WORKER_MODE=cloud_run) ─────────────────
GCP_PROJECT_ID=f1-data-library
CLOUD_RUN_REGION=europe-west1
CLOUD_RUN_JOB_NAME=f1-telemetry-import

# Local: path to trigger SA JSON key (outside the repo)
# GOOGLE_APPLICATION_CREDENTIALS=/Users/YOU/.config/gcloud/interval-jobs-trigger.json
#
# Vercel Preview + Production (required for real loads; never stub on those):
# JOB_WORKER_MODE=cloud_run
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# GCP_PROJECT_ID=f1-data-library
# INGEST_SOURCE=fastf1

# Or split:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=interval-jobs-trigger@f1-data-library.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── BigQuery / pipeline (used by the Python worker) ──────────────────────────
BQ_PROJECT=f1-data-library
BQ_DATASET=f1_data_library_DS
# FASTF1_CACHE_DIR=/tmp/fastf1-cache
# FASTF1_CACHE_GCS_URI=gs://f1-data-library-fastf1-cache/fastf1
# WORKER_DRY_RUN=1

# ── Kaggle (optional, OFF for v1 until proven) ───────────────────────────────
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# KAGGLE_DATASET=

# Existing Interval.ai / Firebase vars can remain in .env.local
