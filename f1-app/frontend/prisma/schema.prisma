datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials auth
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  savedViews    SavedView[]
  usageLogs     UsageLog[]
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userType      String?  // Fan, Creator, Analyst, Engineer
  favDrivers    String[]
  favTeams      String[]
  interests     String[]
  goals         String[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SavedView {
  id        String   @id @default(cuid())
  userId    String
  title     String
  prompt    String
  sql       String   @db.Text
  chartSpec String   @db.Text // JSON string
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @default(now()) @db.Date
  queryCount  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PromptLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  prompt    String
  response  String   @db.Text
  model     String
  toolCalls Json? 
}

model Result {
  id          String   @id @default(cuid())
  sessionId   String
  driverId    String
  position    Int?
  points      Float?
  grid        Int?
  laps        Int?
  status      String?
  timeMs      Int?
  fastestLap  Int?
  rank        Int?
  
  // Metadata for querying
  season      Int
  round       Int
  circuitId   String
  
  createdAt   DateTime @default(now())
  
  @@index([sessionId, driverId])
  @@index([season, round])
}
